{"onglets":{"alias":"o","tpl":"<button data-vrt-item=\"onglets\" type=\"button\" role=\"tab\" onclick=\"VRT.act('o__aller',this,event)\" style=\"position:relative;display:inline-flex;align-items:center;gap:9px;padding:12px 20px 14px;border-radius:10px;border:0;background:{{ o.fond }};color:{{ o.texte }};font:{{ o.graisse }} 14.5px Poppins,sans-serif;cursor:pointer;transition:background .18s,color .18s\" class=\"vh21\">\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"{{ o.teinte }}\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex:0 0 auto\" aria-hidden=\"true\"><use href=\"{{ o.ico }}\"></use></svg>{{ o.nom }}\n                <span aria-hidden=\"true\" style=\"position:absolute;left:16px;right:16px;bottom:6px;height:3px;border-radius:3px;background:{{ o.trait }};transition:background .18s\"></span></button>"},"services":{"alias":"s","tpl":"<div data-vrt-item=\"services\" data-reveal style=\"background:#FAFBFE;border:1px solid transparent;border-radius:12px;padding:24px 22px;display:flex;flex-direction:column;transition:border-color .18s,transform .18s,box-shadow .18s\" class=\"vh22\">\n              <span style=\"width:46px;height:46px;border-radius:50%;background:#fff;border:3px solid {{ s.teinte }};color:#001136;display:flex;align-items:center;justify-content:center;align-self:center;margin-bottom:15px\">\n                <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"{{ s.ico }}\"></use></svg></span>\n              <h3 style=\"font:600 17px/25px Poppins,sans-serif;color:#001136;margin:0 0 7px;text-align:center\">{{ s.titre }}</h3>\n              <p style=\"margin:0 0 16px;font-size:14px;line-height:1.65;color:#4D5163;text-wrap:pretty;text-align:center\">{{ s.desc }}</p>\n              <div style=\"margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:14px\">\n                <span style=\"font:600 14px Poppins,sans-serif;color:{{ s.teinte }}\">{{ s.prix }}</span>\n                <a href=\"{{ s.dest }}\" style=\"display:inline-flex;align-items:center;gap:4px;font:600 13.5px Poppins,sans-serif;color:{{ s.teinte }}\">Découvrir<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"#lc-chevron-right\"></use></svg></a>\n              </div>\n            </div>"},"partages":{"alias":"sp","tpl":"<a data-vrt-item=\"partages\" href=\"{{ sp.url }}\" target=\"_blank\" rel=\"noopener\" aria-label=\"{{ sp.nom }}\" style=\"width:38px;height:38px;border-radius:10px;background:{{ sp.fond }};color:{{ sp.teinte }};display:flex;align-items:center;justify-content:center;transition:transform .18s,box-shadow .18s\" class=\"vh26\">\n                  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"{{ sp.ico }}\"></use></svg></a>"},"filtres":{"alias":"f","tpl":"<button data-vrt-item=\"filtres\" type=\"button\" onclick=\"VRT.act('f__aller',this,event)\" style=\"display:inline-flex;align-items:center;gap:8px;border:1.5px solid {{ f.bord }};background:{{ f.fond }};color:{{ f.texte }};border-radius:100px;padding:9px 17px;font:{{ f.graisse }} 14px Poppins,sans-serif;cursor:pointer;transition:border-color .18s,color .18s,background .18s,transform .18s\" class=\"vh42\">\n                <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"{{ f.ico }}\"></use></svg>{{ f.nom }}</button>"},"manuels":{"alias":"m","tpl":"<article data-vrt-item=\"manuels\" data-reveal class=\"vbq-card\" style=\"--vbq-teinte:{{ m.teinte }};--vbq-fondA:{{ m.fondA }};--vbq-fondB:{{ m.fondB }}\">\n              <div class=\"vbq-cover\">\n                <!-- Trois façons de montrer un livre, dans cet ordre : la vraie\n                     couverture si elle existe, la composition littéraire pour un\n                     roman, la maquette du cahier sinon. Aucune carte ne peut\n                     donc rester vide — c'est précisément ce qui arrivait au\n                     Tube digestif, dont l'image était un 404. -->\n                <sc-if value=\"{{ m.couv }}\">\n                  <img src=\"{{ m.couv }}\" alt=\"Couverture — {{ m.titre }}\" loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"1013\">\n                </sc-if>\n                <sc-if value=\"{{ m.couvRoman }}\">\n                  <span class=\"vbq-couv vbq-couv-roman\" role=\"img\" aria-label=\"Couverture — {{ m.titre }}\" style=\"--vbq-teinte:{{ m.couvTeinte }}\">\n                    <span class=\"vbq-couv-filet\" aria-hidden=\"true\"></span>\n                    <span class=\"vbq-couv-rtitre\">{{ m.couvRTitre }}</span>\n                    <span class=\"vbq-couv-raut\">{{ m.couvRAut }}</span>\n                    <span class=\"vbq-couv-rmention\">{{ m.couvRMention }}</span>\n                  </span>\n                </sc-if>\n                <sc-if value=\"{{ m.couvCahier }}\">\n                  <span class=\"vbq-couv vbq-couv-cahier\" role=\"img\" aria-label=\"Couverture — {{ m.titre }}\" style=\"--vbq-teinte:{{ m.couvTeinte }}\">\n                    <span class=\"vbq-couv-haut\">{{ m.couvHaut }}</span>\n                    <span class=\"vbq-couv-titre\">{{ m.couvTitre }}</span>\n                    <span class=\"vbq-couv-niv\">{{ m.couvNiv }}</span>\n                    <span class=\"vbq-couv-ruban\">{{ m.couvRuban }}</span>\n                    <span class=\"vbq-couv-marque\">Centre VÉRITAS</span>\n                  </span>\n                </sc-if>\n                <span class=\"vbq-niv\">{{ m.niv }}</span>\n                <span class=\"vbq-badges\">\n                  <span class=\"{{ m.formatCls }}\">{{ m.formatNom }}</span>\n                  <sc-if value=\"{{ m.etiquette }}\">\n                    <span class=\"vbq-tag\" style=\"background:{{ m.etiquetteFond }}\">{{ m.etiquette }}</span>\n                  </sc-if>\n                </span>\n              </div>\n              <div class=\"vbq-body\">\n                <span class=\"vbq-cat\">{{ m.categorie }}</span>\n                <h3 class=\"vbq-titre\">{{ m.titre }}</h3>\n                <p class=\"vbq-type\">{{ m.type }}</p>\n                <sc-if value=\"{{ m.exos }}\">\n                  <small class=\"vbq-exos\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"#lc-checkcircle\"></use></svg>{{ m.exos }}</small>\n                </sc-if>\n                <div class=\"vbq-prix-row\">\n                  <span>\n                    <small class=\"vbq-prix-lbl\">Prix</small>\n                    <b class=\"vbq-prix\">{{ m.prix }}</b>\n                    <small class=\"vbq-mention\">{{ m.mention }}</small>\n                  </span>\n                  <sc-if value=\"{{ m.papier }}\">\n                    <button type=\"button\" class=\"vbq-cta\" onclick=\"VRT.act('m__commander',this,event)\" aria-label=\"Commander {{ m.titre }}\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"#lc-basket\"></use></svg>Commander</button>\n                  </sc-if>\n                  <!-- Un livre vendu en lecture en ligne ne se « commande » pas :\n                       il s'ouvre. Le lien mène à sa fiche dans l'application,\n                       où l'aperçu gratuit commence sans compte. -->\n                  <sc-if value=\"{{ m.lien }}\">\n                    <a href=\"{{ m.lien }}\" class=\"vbq-lire\" aria-label=\"Lire {{ m.titre }} en ligne\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"#lc-bookopen\"></use></svg>Lire en ligne</a>\n                  </sc-if>\n                  <!-- Le bouton qui VEND (15/09/2026). `m.acheter` porte le\n                       tunnel qui sait livrer ce produit-là ; le choix se fait\n                       dans carteDepuisLivre (assets/vitrine.js), commenté. -->\n                  <sc-if value=\"{{ m.acheter }}\">\n                    <a href=\"{{ m.acheter }}\" class=\"vbq-cta\" aria-label=\"Commander {{ m.titre }}\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"#lc-basket\"></use></svg>Commander</a>\n                  </sc-if>\n                </div>\n              </div>\n            </article>"},"moyensPaiement":{"alias":"mp","tpl":"<button data-vrt-item=\"moyensPaiement\" type=\"button\" onclick=\"VRT.act('mp__choisir',this,event)\" style=\"position:relative;display:flex;align-items:center;gap:14px;text-align:left;background:{{ mp.fond }};border:2px solid {{ mp.bord }};border-radius:14px;padding:18px;cursor:pointer;transition:border-color .18s,background .18s,transform .18s\" class=\"vh52\">\n                  <span style=\"width:72px;height:48px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;flex:0 0 auto;box-shadow:inset 0 0 0 1px rgba(0,17,54,.07)\"><svg width=\"64\" height=\"26\" viewBox=\"0 0 80 32\" aria-hidden=\"true\"><use href=\"{{ mp.marque }}\"></use></svg></span>\n                  <span style=\"display:flex;flex-direction:column;line-height:1.4;flex:1;min-width:0\">\n                    <b style=\"font:600 15.5px Poppins,sans-serif;color:#001136\">{{ mp.nom }}</b>\n                    <small style=\"font:400 12.5px Poppins,sans-serif;color:#6E7385\">{{ mp.desc }}</small>\n                  </span>\n                  <sc-if value=\"{{ mp.actif }}\">\n                    <span style=\"width:24px;height:24px;border-radius:50%;background:{{ mp.teinte }};color:#fff;display:flex;align-items:center;justify-content:center;flex:0 0 auto;animation:vpop .3s cubic-bezier(.22,1,.36,1)\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><use href=\"#lc-check\"></use></svg></span>\n                  </sc-if>\n                </button>"},"champsPaiement":{"alias":"cp","tpl":"<label data-vrt-item=\"champsPaiement\" style=\"display:flex;flex-direction:column;gap:7px;grid-column:{{ cp.colonne }}\">\n                  <span style=\"font:500 13px Poppins,sans-serif;color:#001136\">{{ cp.label }}</span>\n                  <span style=\"position:relative;display:flex;align-items:center\">\n                    <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9BA6BE\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"position:absolute;left:14px;pointer-events:none\" aria-hidden=\"true\"><use href=\"{{ cp.ico }}\"></use></svg>\n                    <input id=\"{{ cp.champ }}\" name=\"{{ cp.champ }}\" type=\"{{ cp.type }}\" autocomplete=\"{{ cp.auto }}\" value=\"{{ cp.valeur }}\" placeholder=\"{{ cp.exemple }}\" style=\"width:100%;border:1.5px solid transparent;border-radius:12px;padding:13px 14px 13px 41px;font:400 14.5px Poppins,sans-serif;color:#001136;outline:0;background:#FAFBFE;transition:border-color .18s,background .18s\" style-focus=\"border-color:#1E499B;background:#fff\">\n                  </span>\n                </label>"},"optionsLivraison":{"alias":"ol","tpl":"<button data-vrt-item=\"optionsLivraison\" type=\"button\" onclick=\"VRT.act('ol__choisir',this,event)\" style=\"display:flex;align-items:center;gap:14px;text-align:left;background:{{ ol.fond }};border:2px solid {{ ol.bord }};border-radius:14px;padding:16px 18px;cursor:pointer;transition:border-color .18s,background .18s\">\n                  <span style=\"width:20px;height:20px;border-radius:50%;border:2px solid {{ ol.puce }};display:flex;align-items:center;justify-content:center;flex:0 0 auto\">\n                    <sc-if value=\"{{ ol.actif }}\"><span style=\"width:10px;height:10px;border-radius:50%;background:#1E499B;display:block;animation:vpop .28s cubic-bezier(.22,1,.36,1)\"></span></sc-if>\n                  </span>\n                  <span style=\"display:flex;flex-direction:column;line-height:1.4;flex:1;min-width:0\">\n                    <b style=\"font:600 15px Poppins,sans-serif;color:#001136\">{{ ol.nom }}</b>\n                    <small style=\"font:400 12.5px Poppins,sans-serif;color:#6E7385\">{{ ol.desc }}</small>\n                  </span>\n                  <b style=\"font:600 14.5px Poppins,sans-serif;color:{{ ol.prixCouleur }};white-space:nowrap;flex:0 0 auto\">{{ ol.prix }}</b>\n                </button>"},"lignesTotal":{"alias":"lt","tpl":"<span data-vrt-item=\"lignesTotal\" style=\"display:flex;align-items:center;justify-content:space-between;gap:12px\">\n                  <span style=\"font:{{ lt.graisse }} 13.5px Poppins,sans-serif;color:{{ lt.couleur }}\">{{ lt.libelle }}</span>\n                  <span style=\"font:{{ lt.graisse }} 13.5px Poppins,sans-serif;color:{{ lt.couleur }};white-space:nowrap\">{{ lt.montant }}</span>\n                </span>"}}