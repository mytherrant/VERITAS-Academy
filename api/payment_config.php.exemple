//  2. Remplacez les valeurs "À_REMPLIR_..." par vos vraies credentials
//  3. NE COMMITTEZ JAMAIS payment_config.php sur GitHub !
// ============================================================

// ============================================================
// 🟠 ORANGE MONEY WEBPAYMENT (Cameroun)
// ============================================================
// 👉 Allez sur https://developer.orange.com → Mes applications
// 👉 Souscrivez au produit "Orange Money WebPayment Cameroon"
// 👉 Récupérez les 3 valeurs ci-dessous depuis votre dashboard

if (!defined('ORANGE_CLIENT_ID')) define('ORANGE_CLIENT_ID',     'À_REMPLIR_DEPUIS_DEVELOPER_ORANGE');
if (!defined('ORANGE_CLIENT_SECRET')) define('ORANGE_CLIENT_SECRET', 'À_REMPLIR_DEPUIS_DEVELOPER_ORANGE');
if (!defined('ORANGE_MERCHANT_KEY')) define('ORANGE_MERCHANT_KEY',  'À_REMPLIR_DEPUIS_DEVELOPER_ORANGE');

// API base (identique sandbox/prod)
if (!defined('ORANGE_API_BASE')) define('ORANGE_API_BASE',      'https://api.orange.com');
// Code pays : 'cm' = Cameroun
if (!defined('ORANGE_COUNTRY_CODE')) define('ORANGE_COUNTRY_CODE',  'cm');
// Devise : 'OUV' en sandbox, 'XAF' en production
if (!defined('ORANGE_CURRENCY')) define('ORANGE_CURRENCY',      'OUV');     // ← changez en 'XAF' pour la prod

// ============================================================
// 📱 MTN MOBILE MONEY COLLECTION (Cameroun)
// ============================================================
// 👉 Allez sur https://momodeveloper.mtn.com → Profile
// 👉 Copiez votre Primary Key (= MTN_SUBSCRIPTION_KEY)
// 👉 Souscrivez au produit "Collection"
// 👉 Générez un API User + API Key (2 appels curl, voir GUIDE_MTN_MOMO_API.md)

if (!defined('MTN_API_USER')) define('MTN_API_USER',         'À_REMPLIR_UUID_V4_DE_API_USER');
if (!defined('MTN_API_KEY')) define('MTN_API_KEY',          'À_REMPLIR_API_KEY_RETOURNEE_PAR_CURL');
if (!defined('MTN_SUBSCRIPTION_KEY')) define('MTN_SUBSCRIPTION_KEY', 'À_REMPLIR_PRIMARY_KEY_DU_DASHBOARD');

// Environnement : 'sandbox' pour tester, 'mtncameroon' en production
if (!defined('MTN_TARGET_ENV')) define('MTN_TARGET_ENV',       'sandbox');
// API base : sandbox.momodeveloper.mtn.com en test, proxy.momoapi.mtn.com en prod
if (!defined('MTN_API_BASE')) define('MTN_API_BASE',         'https://sandbox.momodeveloper.mtn.com');

// ============================================================
// 🔀 QUEL FOURNISSEUR ENCAISSE ? (CamerPay ou CamPay)
// ============================================================
// VÉRITAS sait parler aux deux. Cette constante tranche :
//   'auto'     → CamerPay s'il est configuré, sinon CamPay  (défaut)
//   'camerpay' → forcer CamerPay
//   'campay'   → forcer CamPay (le jour où le compte bancaire entreprise existe)
// Le frontend interroge api/payment_camerpay.php?action=config et suit la
// réponse : aucune case à cocher à retoucher dans l'application.
if (!defined('PAY_PROVIDER')) define('PAY_PROVIDER', 'auto');

// ============================================================
// 🇨🇲 CAMERPAY — passerelle camerounaise (Orange Money, MTN MoMo, carte, PayPal)
// ============================================================
// ⭐ VOIE DE LANCEMENT : contrairement à CamPay, CamerPay N'EXIGE PAS de compte
//    bancaire d'entreprise ni d'historique d'activité. On teste en sandbox sans
//    aucun document, et le premier niveau de KYC demande simplement la CNI du
//    gérant OU un extrait RCCM. Les retraits partent vers un Mobile Money au
//    nom de l'entreprise OU DU GÉRANT.
//
//    Plafonds de volume mensuel selon les documents fournis (doc /docs/kyc-tiers) :
//      KYC-1  CNI du gérant OU RCCM ................  200 000 FCFA / mois
//      KYC-2  identité + attestation NIU ........... 1 000 000 FCFA / mois
//      KYC-3  RCCM + NIU + justificatif de siège ... illimité
//    Un dépassement renvoie HTTP 402 avec le document exact à fournir.
//
//    Tarifs (relevés sur le tableau de bord CamerPay, août 2026) :
//      Démarreur     0 XAF/mois + 3 %   — plafonné à 100 transactions/mois
//      Entreprise  500 XAF/mois + 1,5 % — transactions ILLIMITÉES  ← plan de VÉRITAS
//      Pro       2 500 XAF/mois + 1 %   — transactions illimitées
//    Retrait vers Mobile Money : ~2 % (Orange) / ~3,75 % (MTN), minimum
//    1 000 FCFA, versé sous 24 à 72 h ouvrées.
//
// 👉 1. Créez le compte sur https://camerpay.biz/register (gratuit, sans KYC)
// 👉 2. Dashboard → /client/api → « Générer un nouveau token »
//       ⚠️ Le jeton ne s'affiche QU'UNE FOIS : copiez-le tout de suite.
// 👉 3. Dans le même écran, relevez le « callback secret » (clé des webhooks)
// 👉 4. Déclarez l'URL de webhook :
//       https://veritas-school.com/api/payment_camerpay.php?action=notify
// 👉 5. Testez en sandbox, puis passez CAMERPAY_MODE sur 'live' après le KYC.

if (!defined('CAMERPAY_TOKEN')) define('CAMERPAY_TOKEN', 'À_REMPLIR_TOKEN_BEARER_CAMERPAY');

// 🔐 Secret de signature des webhooks (dashboard → API & webhooks). OBLIGATOIRE.
// CamerPay signe en HMAC-SHA256 la chaîne "uuid|invoice_id|status|amount".
// ⚠️ FAIL-CLOSED : laissé vide, TOUTES les notifications sont rejetées (401) —
//    on ne sait pas d'où elles viennent, donc on ne les croit pas. Aucun
//    paiement n'est perdu pour autant (le suivi du payeur et la réconciliation
//    du tableau de bord relisent le statut chez CamerPay), mais l'activation
//    cesse d'être instantanée. L'écran ⚙️ Paramètres → Paiements API l'affiche
//    en clair tant que ce secret manque.
if (!defined('CAMERPAY_CALLBACK_SECRET')) define('CAMERPAY_CALLBACK_SECRET', '');

// Mode du COMPTE CamerPay. Attention : l'URL de l'API est la même dans les deux
// cas (contrairement à CamPay) — c'est le compte qui décide. Cette constante
// sert donc à AFFICHER la vérité à l'administrateur, pas à la provoquer.
//   'sandbox' → paiements simulés, aucun argent réel (avant KYC)
//   'live'    → encaissement réel (après validation du KYC)
if (!defined('CAMERPAY_MODE')) define('CAMERPAY_MODE', 'sandbox');   // ← 'live' après le KYC

if (!defined('CAMERPAY_API_BASE')) define('CAMERPAY_API_BASE', 'https://camerpay.biz');

// Taux de commission de VOTRE plan, utilisé pour ESTIMER le net encaissé
// (CamerPay ne renvoie pas la commission transaction par transaction).
//   0.03 = Démarreur · 0.015 = Entreprise · 0.01 = Pro
// VÉRITAS est au plan ENTREPRISE (500 XAF/mois) → 1,5 %.
if (!defined('CAMERPAY_FEE_RATE')) define('CAMERPAY_FEE_RATE', 0.015);

// 🔑 JETON PUBLIC D'INITIATION — self-service client (action=init uniquement).
//    Même doctrine que CAMPAY_PUBLIC_INIT : faible privilège, ne peut QUE créer
//    une demande de paiement. Vide = seul l'admin peut encaisser.
//    ⚠️ JAMAIS la même valeur que PAY_API_SECRET / API_SECRET / CAMERPAY_TOKEN.
//    Générez-le p. ex. avec : 'pub_' . bin2hex(random_bytes(16))
//
//    ℹ️ RIEN À RECOPIER dans l'application : la sonde ?action=config transmet
//    ce jeton au navigateur du client. C'est indispensable — un visiteur n'a ni
//    le secret de synchronisation ni la base complète, il ne pouvait donc PAS
//    payer tant que le jeton ne vivait que dans l'écran d'administration.
//    Ce jeton est public par construction (tout navigateur qui paie le détient) :
//    ses vraies barrières sont les trois lignes qui suivent — origine autorisée,
//    débit par IP, plafond de montant. Il ne donne accès à AUCUNE lecture.
if (!defined('CAMERPAY_PUBLIC_INIT')) define('CAMERPAY_PUBLIC_INIT', '');
if (!defined('CAMERPAY_INIT_ALLOWED_ORIGINS')) define('CAMERPAY_INIT_ALLOWED_ORIGINS', 'https://veritas-school.com,https://www.veritas-school.com,https://localhost,capacitor://localhost');
if (!defined('CAMERPAY_INIT_RATE_PER_HOUR')) define('CAMERPAY_INIT_RATE_PER_HOUR', 10);
// Coupe-circuit GLOBAL : initiations en libre-service par jour, toutes adresses
// confondues. Le plan Entreprise étant illimité en transactions, ce plafond ne
// protège pas le quota du fournisseur mais le SERVEUR : chaque initiation crée
// un fichier d'état que le tableau de bord relit ensuite en entier. 0 = désactivé.
if (!defined('CAMERPAY_INIT_MAX_PER_DAY')) define('CAMERPAY_INIT_MAX_PER_DAY', 500);

// ⏳ Durée au bout de laquelle une transaction restée « en attente » est close.
//    Une notification CamerPay perdue n'est JAMAIS rejouée : sans ce balayage,
//    un paiement abouti que le client n'a pas suivi restait « pending » à vie,
//    argent encaissé et accès jamais ouvert. Le tableau de bord vérifie une
//    dernière fois auprès de CamerPay avant de clore — et ne clôt rien si le
//    fournisseur est injoignable. 7 jours par défaut.
if (!defined('CAMERPAY_PENDING_TTL')) define('CAMERPAY_PENDING_TTL', 604800);

// 🔒 Plafonds de sécurité VÉRITAS (indépendants de ceux de CamerPay).
//    Encaissement en libre-service, versement unitaire, total d'un lot.
if (!defined('CAMERPAY_COLLECT_MAX')) define('CAMERPAY_COLLECT_MAX', 500000);
if (!defined('CAMERPAY_PAYOUT_MAX')) define('CAMERPAY_PAYOUT_MAX', 200000);
// CamerPay plafonne lui-même un lot à 2 000 000 FCFA (limite BEAC) et
// 100 bénéficiaires : on ne peut être que plus prudent, jamais plus permissif.
if (!defined('CAMERPAY_MASSPAYOUT_MAX')) define('CAMERPAY_MASSPAYOUT_MAX', 2000000);

// ============================================================
// 💚 CAMPAY — agrégateur MTN MoMo + Orange Money (Cameroun)
// ============================================================
// ⏸️ MIS DE CÔTÉ (août 2026) — CamPay exige un compte bancaire d'entreprise et
//    un historique d'activité, impossibles en phase de lancement. Le code de
//    api/payment_campay.php reste ENTIER et fonctionnel : posez les identifiants
//    ci-dessous et passez PAY_PROVIDER sur 'campay' pour rebasculer.
//
// ⭐ VOIE RECOMMANDÉE POUR DÉMARRER : un seul contrat couvre MTN **et** Orange,
//    compte ouvert en quelques jours, et les VERSEMENTS partenaires (auteurs,
//    parrains) sont inclus — ce que ni Orange WebPayment ni MTN Collection seuls
//    ne permettent. Frais annoncés : 2 % encaissement, 1 % retrait mobile,
//    5 000 FCFA par virement bancaire.
//
// 👉 1. Créez le compte sur https://www.campay.net (au nom du CENTRE VÉRITAS :
//       RCCM + NIU + CNI du gérant — voir GUIDE_CAMPAY.md)
// 👉 2. Dashboard → Application → récupérez username / password d'application
//       (ou un « permanent access token » qui n'expire jamais)
// 👉 3. Déclarez l'URL de webhook dans le dashboard :
//       https://veritas-school.com/api/payment_campay.php?action=notify
// 👉 4. Testez sur le mode démo, puis basculez CAMPAY_API_BASE sur la prod.

if (!defined('CAMPAY_USERNAME')) define('CAMPAY_USERNAME',        'À_REMPLIR_USERNAME_APPLICATION_CAMPAY');
if (!defined('CAMPAY_PASSWORD')) define('CAMPAY_PASSWORD',        'À_REMPLIR_PASSWORD_APPLICATION_CAMPAY');
// Alternative au couple username/password : jeton permanent du dashboard.
// S'il est renseigné, il est utilisé en priorité (aucun appel /api/token/).
if (!defined('CAMPAY_PERMANENT_TOKEN')) define('CAMPAY_PERMANENT_TOKEN', '');

// 🔐 Webhook key de l'application (dashboard CamPay → APP KEYS).
// Le webhook porte un champ `signature` = JWT HS256 signé avec cette clé.
// Si elle est renseignée, toute notification mal signée est REJETÉE (403).
// Laisser vide = contrôle désactivé (le statut reste re-vérifié auprès de CamPay).
if (!defined('CAMPAY_WEBHOOK_KEY')) define('CAMPAY_WEBHOOK_KEY',     '');

// 🔑 JETON PUBLIC D'INITIATION — self-service client (action=init uniquement).
//    Permet au navigateur d'un CLIENT de lancer un encaissement /collect/ SANS
//    détenir PAY_API_SECRET. Faible privilège : ne peut QUE créer une demande
//    de paiement (jamais list/balance/payouts/withdraw), avec allowlist d'Origin
//    + rate-limit par IP ci-dessous. Laisser vide '' = self-service DÉSACTIVÉ
//    (seul l'admin peut alors initier un paiement).
//    ⚠️ NE JAMAIS mettre la même valeur que PAY_API_SECRET / API_SECRET.
//    ⚠️ Doit être RECOPIÉ à l'identique dans Admin → Paramètres → Paiements API
//       → champ « Jeton public CamPay » (c'est cette copie que les clients
//       envoient). Générez-le p. ex. avec : 'pub_' . bin2hex(random_bytes(16)).
if (!defined('CAMPAY_PUBLIC_INIT')) define('CAMPAY_PUBLIC_INIT',          '');
// Origines autorisées à utiliser le jeton public (CSV, sans slash final).
// Inclure les origines de l'app Capacitor (mobile) en plus du site web.
// '' = contrôle d'origine désactivé (le rate-limit reste actif).
if (!defined('CAMPAY_INIT_ALLOWED_ORIGINS')) define('CAMPAY_INIT_ALLOWED_ORIGINS', 'https://veritas-school.com,https://www.veritas-school.com,https://localhost,capacitor://localhost');
// Nombre max de demandes de paiement par IP et par heure via le jeton public.
// 0 = rate-limit désactivé (déconseillé).
if (!defined('CAMPAY_INIT_RATE_PER_HOUR')) define('CAMPAY_INIT_RATE_PER_HOUR',   10);

// Environnement : démo pour tester, prod pour encaisser réellement.
//   Démo : https://demo.campay.net      ← argent fictif
//   Prod : https://www.campay.net       ← argent réel
if (!defined('CAMPAY_API_BASE')) define('CAMPAY_API_BASE',        'https://demo.campay.net');   // ← CHANGER en prod

// Taux de frais utilisé pour l'estimation comptable tant que la transaction ne
// renvoie pas `charge_amount` (2 % annoncés par CamPay en juillet 2026).
// Les frais RÉELS se lisent via ?action=history (champ charge_amount).
if (!defined('CAMPAY_FEE_RATE')) define('CAMPAY_FEE_RATE',        0.02);

// 🔒 Plafond de sécurité par versement partenaire (FCFA). Un seul appel
//    ?action=withdraw ne peut jamais dépasser ce montant : protège d'une erreur
//    de saisie ou d'un jeton admin compromis.
if (!defined('CAMPAY_PAYOUT_MAX')) define('CAMPAY_PAYOUT_MAX',      200000);

// 🔒 Plafond du TOTAL d'un lot ?action=masspayout (ex. paie de 50 enseignants
//    en un appel). Second garde-fou, indépendant du plafond unitaire.
if (!defined('CAMPAY_MASSPAYOUT_MAX')) define('CAMPAY_MASSPAYOUT_MAX',  2000000);

// 🔒 Plafond d'un encaissement initié par le JETON PUBLIC (self-service client).
//    Borne l'abus si le jeton public fuite : un visiteur ne peut pas déclencher
//    un /collect/ de montant arbitraire. L'admin (secret) n'est jamais plafonné.
//    0 = pas de plafond (déconseillé pour le chemin public).
if (!defined('CAMPAY_COLLECT_MAX')) define('CAMPAY_COLLECT_MAX',     500000);

// ============================================================
// 🌐 URLs PUBLIQUES du site VÉRITAS
// ============================================================
// Doivent être HTTPS et accessibles publiquement par Orange/MTN
// pour que les WEBHOOKS fonctionnent.

if (!defined('PUBLIC_BASE_URL')) define('PUBLIC_BASE_URL',      'https://veritas-school.com');     // ← sans le / final
if (!defined('PUBLIC_FRONTEND_URL')) define('PUBLIC_FRONTEND_URL',  'https://veritas-school.com');     // page d'accueil VÉRITAS

// ============================================================
// 🔐 TOKEN API entre VÉRITAS et le backend
// ============================================================
// Doit correspondre à DB.cloudConfig.secret côté frontend
// (visible dans VÉRITAS → Admin → Paramètres → Cloud)
//
// 🔁 ROTATION v1.2.2 : GÉNÉREZ une nouvelle valeur aléatoire longue
//    (ex. en SSH : `openssl rand -hex 24`) et NE RÉUTILISEZ PAS l'ancienne
//    'VERITAS-CLOUD-2026-xK9m' qui a fuité (elle était dans le HTML public).
//    Mettez la MÊME valeur dans l'admin VÉRITAS → Paramètres → Cloud.
if (!defined('API_SECRET')) define('API_SECRET',           'GENEREZ_UN_SECRET_ALEATOIRE_LONG'); // ← sync DB (config_sync.php / db.php)
if (!defined('PAY_API_SECRET')) define('PAY_API_SECRET',       'GENEREZ_UN_SECRET_ALEATOIRE_LONG'); // ← peut être identique à API_SECRET

// ============================================================
// 🤖 IA — Prof. Ambassa (api/ia_proxy.php)
// ============================================================
// La clé reste CÔTÉ SERVEUR (jamais exposée au navigateur).
//
// 👉 GRATUIT (recommandé) — Google Gemini Flash :
//    1. Allez sur https://aistudio.google.com/apikey
//    2. « Create API key » (gratuit, quota généreux ~1500 req/jour)
//    3. Collez la clé ci-dessous.
if (!defined('GEMINI_API_KEY')) define('GEMINI_API_KEY',  '');                 // ← clé Gemini gratuite (laisser vide = IA désactivée)
// v1.2.2 : TOUT passe par Gemini. Le plan choisit le MODÈLE.
//   GEMINI_MODEL       = tier gratuit/visiteurs. Options (mai 2026) :
//     'gemini-2.5-flash'      → 250 req/jour (bon équilibre, défaut)
//     'gemini-2.5-flash-lite' → 1000 req/jour (plus de volume, un peu moins fin)
//   GEMINI_MODEL_ELITE = abonnés Élite (raisonnement avancé) :
//     'gemini-2.5-pro'        → 100 req/jour gratuit (le plus puissant encore gratuit)
//   ⚠️ Gemini 3.x = payant uniquement en 2026.
if (!defined('GEMINI_MODEL')) define('GEMINI_MODEL',       'gemini-2.5-flash');
if (!defined('GEMINI_MODEL_ELITE')) define('GEMINI_MODEL_ELITE', 'gemini-2.5-pro');
//
// 🔁 REPLIS AUTOMATIQUES (remplacent Pollinations déprécié). Laisser vide = repli ignoré.
//    Ordre de bascule si Gemini échoue/sature : Groq → Mistral → Pollinations.
//
// 👉 GROQ (le plus rapide, Llama 70B, ~1000 req/jour gratuit) :
//    https://console.groq.com/keys
if (!defined('GROQ_API_KEY')) define('GROQ_API_KEY',    '');                          // ← clé Groq (gratuite)
if (!defined('GROQ_MODEL')) define('GROQ_MODEL',      'llama-3.3-70b-versatile');
//
// 👉 MISTRAL (excellent français, 1 milliard de tokens/mois gratuit) :
//    https://console.mistral.ai/api-keys
if (!defined('MISTRAL_API_KEY')) define('MISTRAL_API_KEY', '');                          // ← clé Mistral (gratuite)
if (!defined('MISTRAL_MODEL')) define('MISTRAL_MODEL',   'mistral-large-latest');
//
// 🚀 v1.4.2 — « JAMAIS À COURT DE TOKENS » :
// 👉 CEREBRAS — 1 MILLION de tokens/JOUR gratuits (le plus généreux 2026),
//    inférence ~20× plus rapide. Clé : https://cloud.cerebras.ai
if (!defined('CEREBRAS_API_KEY')) define('CEREBRAS_API_KEY', '');                         // ← clé Cerebras (gratuite)
if (!defined('CEREBRAS_MODEL')) define('CEREBRAS_MODEL',   'llama-3.3-70b');
//
// 👉 SAMBANOVA — tier gratuit PERSISTANT (Llama 3.3 70B → 405B).
//    Clé : https://cloud.sambanova.ai
if (!defined('SAMBANOVA_API_KEY')) define('SAMBANOVA_API_KEY', '');                        // ← clé SambaNova (gratuite)
if (!defined('SAMBANOVA_MODEL')) define('SAMBANOVA_MODEL',   'Meta-Llama-3.3-70B-Instruct');
//
// 👉 ROTATION MULTI-CLÉS GEMINI — créez 2-3 clés AI Studio (comptes Google
//    distincts) pour MULTIPLIER le quota du moteur primaire :
if (!defined('GEMINI_API_KEY_2')) define('GEMINI_API_KEY_2', '');                         // ← 2e clé Gemini (optionnel)
if (!defined('GEMINI_API_KEY_3')) define('GEMINI_API_KEY_3', '');                         // ← 3e clé Gemini (optionnel)
//
// 👉 PAYANT (optionnel) — Claude pour le « Plan Élite » :
//    https://console.anthropic.com → API Keys. Si vide, l'Élite utilise aussi Gemini.
if (!defined('ANTHROPIC_API_KEY')) define('ANTHROPIC_API_KEY', '');               // ← clé Anthropic (optionnel, pour Sonnet)

// ============================================================
// 🔐 TOKEN ADMIN — validation des réponses IA (api/admin_validate.php)
// ============================================================
// Choisissez une longue chaîne aléatoire et gardez-la secrète.
if (!defined('ADMIN_TOKEN')) define('ADMIN_TOKEN',     'CHANGEZ_MOI_token_admin_long_et_aleatoire');

// ============================================================
// 📲 REMISE DU CODE PAR SMS / WHATSAPP  (api/_notify_lib.php)
// ============================================================
// POURQUOI. Les 31/08 et 01/09/2026, cinq clients ont payé 1 500 F sans jamais
// voir leur code. Les paiements étaient confirmés, les codes émis et déposés :
// c'est la REMISE qui manquait de canal. Elle ne vivait que dans le navigateur
// de l'acheteur — un onglet ouvert, puis un `localStorage`. Or payer par Orange
// Money oblige à quitter le navigateur pour composer #150*50#, et Android jette
// l'onglet resté derrière.
//
// Le serveur envoie donc maintenant le code au numéro qui a payé, dès que la
// passerelle confirme. TANT QUE VRT_NOTIFY_CANAL EST VIDE, RIEN N'EST ENVOYÉ :
// les remises s'empilent dans une file visible par l'administration
// (api/livret.php, action `admin_notify_list`). Une file visible vaut mieux
// qu'un envoi silencieusement perdu — mais elle ne remplace pas un canal.
//
// Le serveur envoie donc maintenant le code au numéro (ou à l'adresse) de celui
// qui a payé, dès que la passerelle confirme. Les canaux sont ESSAYÉS DANS
// L'ORDRE, séparés par des virgules — le premier qui aboutit gagne :
//   'mail'     → courriel. LE SEUL QUI NE DEMANDE DE COMPTE NULLE PART.
//   'whatsapp' → WhatsApp Cloud API (Meta) — exige un compte Business + modèle
//   'http'     → passerelle SMS décrite par gabarit (ci-dessous)
//   ''         → aucun envoi : la file reste visible, rien ne part
// Défaut si la constante n'existe pas : « mail ».
if (!defined('VRT_NOTIFY_CANAL')) define('VRT_NOTIFY_CANAL', 'mail');

// ⚠️ LA LIGNE LA PLUS IMPORTANTE DE CE BLOC.
// Adresse qui reçoit une ALERTE quand un code payé n'a pas pu être remis (pas
// d'adresse client, passerelle en panne…). L'alerte porte le code ET un lien
// WhatsApp pré-rempli vers le numéro du client : un appui, et il l'a.
// Vide = aucune alerte, et l'échec ne se lit que dans `admin_notify_list`.
if (!defined('VRT_NOTIFY_ADMIN_MAIL')) define('VRT_NOTIFY_ADMIN_MAIL', '');   // ← À REMPLIR

// Expéditeur des courriels. DOIT être une adresse DU DOMAINE : un « From » chez
// gmail posté par nos serveurs échoue SPF et part en indésirable.
if (!defined('VRT_NOTIFY_FROM'))    define('VRT_NOTIFY_FROM',    'no-reply@veritas-school.com');
if (!defined('VRT_NOTIFY_REPLYTO')) define('VRT_NOTIFY_REPLYTO', 'contact@veritas-school.com');

// Numéro d'aide imprimé en fin de message.
if (!defined('VRT_NOTIFY_AIDE'))  define('VRT_NOTIFY_AIDE', '697 63 77 39');

// ── A) PASSERELLE SMS GÉNÉRIQUE ─────────────────────────────
// Aucun fournisseur n'est câblé en dur : ce qui change d'une passerelle à
// l'autre est toujours une URL, une méthode, un corps de requête et un en-tête
// d'authentification. Un gabarit les couvre toutes sans une ligne de code.
//
// Gabarits disponibles dans VRT_SMS_URL et VRT_SMS_CORPS :
//   {tel}        numéro international sans « + »   → 237690361319
//   {tel_plus}   avec le « + »                     → +237690361319
//   {tel_local}  sans indicatif                    → 690361319
//   {msg}        le message (déjà sans accents, pour tenir en 1 SMS)
//
// ⚠️ Reprenez l'URL et les noms de paramètres DANS LA DOCUMENTATION DE VOTRE
//    fournisseur : ils changent d'un opérateur à l'autre et d'une version à
//    l'autre. Les valeurs ci-dessous sont un gabarit de forme, pas une adresse
//    vérifiée.
if (!defined('VRT_SMS_URL'))     define('VRT_SMS_URL',     '');           // https://…/sendsms
if (!defined('VRT_SMS_METHODE')) define('VRT_SMS_METHODE', 'POST');       // POST | GET
if (!defined('VRT_SMS_TYPE'))    define('VRT_SMS_TYPE',    'form');       // form | json
if (!defined('VRT_SMS_CORPS'))   define('VRT_SMS_CORPS',   '');           // gabarit du corps
if (!defined('VRT_SMS_ENTETES')) define('VRT_SMS_ENTETES', '');           // « En-tête: valeur » séparés par |
// Beaucoup de passerelles répondent 200 aussi bien pour « message accepté » que
// pour « solde épuisé ». Ce fragment doit apparaître dans la réponse pour que la
// remise soit comptée LIVRÉE. Vide = on s'en tient au code HTTP, faute de mieux
// — et une remise jamais partie sera comptée comme livrée. À renseigner.
if (!defined('VRT_SMS_OK'))      define('VRT_SMS_OK',      '');
//
// Exemple de forme, avec un corps en formulaire :
//   define('VRT_SMS_CORPS', 'user=MONCOMPTE&password=MONMDP&senderid=VERITAS&mobiles={tel}&sms={msg}');
// Exemple de forme, avec un corps JSON et un jeton :
//   define('VRT_SMS_TYPE',    'json');
//   define('VRT_SMS_CORPS',   '{"to":"{tel_plus}","from":"VERITAS","text":"{msg}"}');
//   define('VRT_SMS_ENTETES', 'Authorization: Bearer MON_JETON');

// ── B) WHATSAPP CLOUD API (Meta) ────────────────────────────
// developers.facebook.com → WhatsApp → API Setup : identifiant du numéro
// expéditeur + jeton permanent.
// ⚠️ Un message envoyé à quelqu'un qui ne nous a pas écrit dans les 24 h DOIT
//    passer par un MODÈLE approuvé par Meta. Sans VRT_WA_MODELE, l'envoi ne
//    fonctionnera qu'en essai, sur un numéro qui vient d'écrire au compte.
//    Le modèle attend UN paramètre de corps : le message complet, sur une ligne.
if (!defined('VRT_WA_PHONE_ID')) define('VRT_WA_PHONE_ID', '');
if (!defined('VRT_WA_TOKEN'))    define('VRT_WA_TOKEN',    '');
if (!defined('VRT_WA_MODELE'))   define('VRT_WA_MODELE',   '');           // ex. « code_acces_veritas »
if (!defined('VRT_WA_LANGUE'))   define('VRT_WA_LANGUE',   'fr');
if (!defined('VRT_WA_VERSION'))  define('VRT_WA_VERSION',  'v21.0');

// Délai maximal d'un envoi. Serré volontairement : cet appel a lieu pendant
// qu'une passerelle de PAIEMENT attend notre 200 — au-delà, elle conclut à
// l'échec et rejoue le webhook.
if (!defined('VRT_NOTIFY_TIMEOUT')) define('VRT_NOTIFY_TIMEOUT', 10);

// ============================================================
// 🔧 CORS — BUG FIX #2 (juin 2026) : AUCUN header émis ici.
// ============================================================
// payment_config.php est une BIBLIOTHÈQUE DE CONFIG incluse par de nombreux
// endpoints (db.php via config_sync, payment_*.php, ia_proxy, content.php via
// _auth_lib…). Émettre des headers + `exit` sur OPTIONS ici :
//   • répondait au preflight AVANT config_sync.php avec Allow-Methods SANS PUT
//     → le navigateur refusait le PUT de la synchro vers db.php ;
//   • corrompait content.php (header JSON avant diffusion d'un binaire).
// Chaque endpoint gère désormais ses propres headers CORS (allowlist stricte).

// ============================================================
// 🛡️ Vérification du token (utilisé par les endpoints init/list)
// ============================================================
function requirePayAuth() {
    $auth = '';
    if (function_exists('getallheaders')) {
        foreach (getallheaders() as $key => $value) {
            if (strtolower($key) === 'authorization') { $auth = $value; break; }
        }
    }
    if (!$auth && isset($_SERVER['HTTP_AUTHORIZATION']))          $auth = $_SERVER['HTTP_AUTHORIZATION'];
    if (!$auth && isset($_SERVER['REDIRECT_HTTP_AUTHORIZATION'])) $auth = $_SERVER['REDIRECT_HTTP_AUTHORIZATION'];
    // 🔐 SÉCURITÉ : PLUS de repli ?secret= en URL. Un secret en query string finit
    //    dans les logs serveur/proxy, l'historique et l'en-tête Referer. Le client
    //    n'envoie plus JAMAIS le secret en URL — uniquement via l'en-tête Authorization.
    //    (Ancien code retiré : if (!$auth && isset($_GET['secret'])) $auth = 'Bearer '.$_GET['secret'];)

    $token = trim(str_replace(['Bearer ', 'bearer '], '', $auth));
    // 🔐 BUG FIX #3 : comparaison à temps constant (anti timing-oracle).
    if ($token === '' || !hash_equals(PAY_API_SECRET, $token)) {
        http_response_code(401);
        echo json_encode(['error' => 'Token API requis ou invalide']);
        exit;
    }
}
