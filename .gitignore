# Backups
*_backup*.html
*_old*.html
*_work*.html

# OS
Thumbs.db
.DS_Store
desktop.ini

# IDE
.vscode/
.idea/

# Claude Code
.claude/

# Logs
*.log
npm-debug.log*

# Temp
/tmp/
*.tmp

# Python (indexation corpus) — cache régénérable
__pycache__/
*.pyc

# Documents juridiques / business locaux (SARL) — ne jamais versionner ni déployer
SARL/

# Node / backend non utilisé
node_modules/
veritas-backend/

# Tests E2E Playwright — artefacts régénérables (rapports, captures, traces)
/test-results/
/playwright-report/
/blob-report/
/.cache/

# Credentials serveur — ne jamais versionner
api/config.php
api/payment_config.php
# Identifiants MySQL + jeton d'installation de VÉRITAS Campus. Même règle que
# ci-dessus : le fichier vit sur le serveur, jamais dans un dépôt public.
api/campus/_config.php

# La BASE synchronisee du site (data/veritas_db.json + ses sauvegardes).
# Elle contient des donnees personnelles reelles : noms d'eleves, telephones
# des parents, paiements, comptes. Le depot GitHub est PUBLIC — un seul
# « git add -A » suffisait a l'y publier, definitivement (l'historique ne
# s'efface pas). Rien de ce dossier n'a a etre versionne : le serveur le
# cree lui-meme au premier demarrage (api/db.php).
data/

# Contenu de api/data/ ignoré (index RAG .db lourds, logs, PII paiements)…
api/data/*
# …SAUF les sentinelles de sécurité, qui DOIVENT être déployées par la CI :
!api/data/.htaccess
!api/data/index.php
api/data/_security_log.txt
api/data/_access_log.txt
api/data/payments/

# Temp scripts
_integrate.py
_apply_formatting.py
_eval_insert.js

# Scripts de diagnostic / session générés par Claude Code
*.ps1
apply_fixes*.py
diag*.py
diag*.txt
diag*.js
generate_veritas*.py
check_veritas*.js
Tempcheck_veritas.js
UsersMYTHEE~1*.js

# Scripts de patch temporaires (appliqués puis obsolètes)
patch_*.js
fix_*.js
_check*.js

# Build local FTP
deploy/

# Graphe de connaissance graphify — local uniquement (régénérable, jamais déployé)
graphify-out/

# Horodatage / preuve d'antériorité (LOCAL UNIQUEMENT — contient un ZIP du code
# source : ne JAMAIS committer ni déployer, sinon tout le code serait téléchargeable).
horodatage/

# Fichiers de travail temporaires
# /app.html = copie RACINE générée par la CI (depuis VERITAS_v1.2.html) — ne pas versionner.
# Ancré à la racine pour NE PAS attraper campus/app.html (qui, lui, est une vraie source).
/app.html
# index.html = copie générée (déploiement / aperçu local) — ne pas versionner
/index.html
VERITAS_v1.0.html
VERITAS_*_fra.html
VERITAS_*_updated.html
Guide_*.html
VERITAS_Guide_*.pdf

# Images / médias locaux non versionnés
*.jpg
*.jpeg
# Exception : avatar de l'IA Ambassa (portrait stylisé)
!ambassa-avatar.jpg
!ambassa-avatar.png
# Exception : couvertures des œuvres littéraires (versionnées + déployées)
!uploads/oeuvres/
!uploads/oeuvres/*.jpg
!uploads/oeuvres/*.png
# Exception : bannière de partage (og:image, 1200×630). Elle est référencée par
# <meta property="og:image"> et copiée par deploy.yml, mais la règle *.jpg la
# retirait du dépôt : la CI ne la voyait donc jamais et l'URL renvoyait 404 en
# production — aucun aperçu lors d'un partage WhatsApp/Facebook, sur un site
# dont l'acquisition repose précisément sur le partage. Vérifié le 27/07/2026.
!og-image.jpg
seo/
_build/

# ─── CONTENU PAYANT : jamais dans le dépôt (GitHub est PUBLIC) ───────────────
# uploads/protected/ contient les œuvres vendues : pages du lecteur sécurisé,
# fragments EPUB, livrets, .pdf/.epub sources. La règle *.jpg couvrait par
# hasard les pages d'images ; RIEN ne couvrait un .epub ni un fragment .html —
# un roman entier partait donc en clair au premier « git add . ». Ces fichiers
# se déposent par FTP, comme le rappelle uploads/protected/livrets/LISEZMOI.txt.
# Seuls les verrous et les modes d'emploi restent versionnés.
uploads/protected/**
!uploads/protected/.htaccess
!uploads/protected/**/.htaccess
!uploads/protected/**/LISEZMOI.txt
